import time
from playwright.sync_api import sync_playwright

# بيانات الدخول الخاصة بك على منصة كيريو / الثقافة المالية
LOGIN_URL = "https://x-learning-square.com"
USERNAME = "اكتب_اسم_المستخدم_هنا"
PASSWORD = "اكتب_كلمة_المرور_هنا"

def run_solver():
    with sync_playwright() as p:
        # تشغيل المتصفح بشكل مرئي لترى العمليات تتم أمامك
        browser = p.chromium.launch(headless=False)
        context = browser.new_context()
        page = context.new_page()

        print("[+] جاري الاتصال بمنصة كيريو والثقافة المالية...")
        page.goto(LOGIN_URL)
        page.wait_for_load_state("networkidle")

        # 1. تسجيل الدخول تلقائياً
        try:
            print("[+] جاري تسجيل الدخول بحسابك...")
            page.fill("input[type='text']", USERNAME)
            page.fill("input[type='password']", PASSWORD)
            page.click("button[type='submit']")
            page.wait_for_timeout(4000)
            print("[+] تم تسجيل الدخول بنجاح!")
        except Exception as e:
            print(f"[-] خطأ في تسجيل الدخول: {e}")

        # 2. حل الدروس والتنقل الآلي
        while True:
            try:
                next_btn = page.query_selector("text='أكمل التعلم'") or page.query_selector(".btn-next")
                if next_btn and next_btn.is_visible():
                    next_btn.click()
                    print("[+] جاري حل الدرس والانتقال للخطوة التالية...")
                    page.wait_for_timeout(2500)
                else:
                    print("[!] تم الوصول لنهاية المتاح أو تتطلب الصفحة تدخلاً لاختبار.")
                    break
            except Exception as ex:
                print(f"[-] حدث خطأ أثناء الحل: {ex}")
                break

        print("[+] تمت عملية التشغيل بنجاح.")
        browser.close()

if __name__ == "__main__":
    run_solver()
